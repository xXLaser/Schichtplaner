{
  "name": "schichtwerk-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Schichtwerk lokale Desktop-App",
  "main": "main.js",
  "author": "Schichtwerk",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "local.schichtwerk.app",
    "productName": "Schichtwerk",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "first-run.html",
      "first-run-preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist-windows-dienst",
        "to": "app",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Schichtwerk.exe"
    },
    "portable": {
      "artifactName": "Schichtwerk.exe"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
