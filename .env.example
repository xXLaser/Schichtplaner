# Lokale SQLite-Datenbank (Standard für EXE und Entwicklung)
DATABASE_URL="file:./dev.db"

# Optional: Geheimer Schlüssel für Sitzungen (in Produktion setzen)
# SESSION_SECRET="ihr-geheimer-schluessel"

# Optional: Externe MySQL-Datenbank (erfordert Neustart und prisma generate mit MySQL-Provider)
# DATABASE_URL="mysql://user:password@localhost:3306/schichtwerk"

# Netzwerk: HOSTNAME=127.0.0.1 (nur lokal) oder 0.0.0.0 (Netzwerk)
# HOSTNAME=127.0.0.1
