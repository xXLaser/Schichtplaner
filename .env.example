# Onboard-SQLite (Standard für lokale EXE / Einzelplatz)
DATABASE_URL="file:./dev.db"

# Optional: externe MySQL (nach npm run db:use-mysql + prisma generate)
# DATABASE_URL="mysql://user:pass@localhost:3306/schichtwerk"

# Optional: Config-Datei (DB-Modus, Web-Zugriff, Feiertage)
# SCHICHTWERK_CONFIG="C:/Users/NAME/AppData/Local/Schichtwerk/schichtwerk.config.json"
